{
  "manifest_version": 4,
  "name": "impervious ZenCorD",
  "description": "ZenCoRD — Discord voice enhancement extension.",
  "version": "1.0.0",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://discord.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://discord.com/*"
      ],
      "js": [
        "bridge.js",
        "loud-voice.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injector.js"
      ],
      "matches": [
        "*://discord.com/*"
      ]
    }
  ]
}
